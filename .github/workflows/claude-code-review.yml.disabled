name: Claude Code Review

on:
  pull_request:
    types: [opened, synchronize, ready_for_review, reopened]
    # Optional: Only run on specific file changes
    # paths:
    #   - "src/**/*.ts"
    #   - "src/**/*.tsx"
    #   - "src/**/*.js"
    #   - "src/**/*.jsx"

jobs:
  claude-review:
    # Optional: Filter by PR author
    # if: |
    #   github.event.pull_request.user.login == 'external-contributor' ||
    #   github.event.pull_request.user.login == 'new-developer' ||
    #   github.event.pull_request.author_association == 'FIRST_TIME_CONTRIBUTOR'

    runs-on: ubuntu-latest
    permissions:
      contents: read
      pull-requests: read
      issues: read
      id-token: write
      actions: read # Required for Claude to read CI results on PRs

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 1

      # NOTE: If enabling this workflow, it will overlap with
      # `governance-ai-review.yml`, which already runs an ADR-aware review on
      # every PR using `.github/ai-review-prompts/adr-rubric.md` + a per-phase
      # rubric. Either disable `governance-ai-review.yml` first, or replace the
      # generic `/code-review:code-review` prompt below with one that sources
      # the ADR rubric so the two reviews do not duplicate or contradict.
      - name: Run Claude Code Review
        id: claude-review
        uses: anthropics/claude-code-action@v1
        with:
          claude_code_oauth_token: ${{ secrets.CLAUDE_CODE_OAUTH_TOKEN }}
          plugin_marketplaces: 'https://github.com/anthropics/claude-code.git'
          plugins: 'code-review@claude-code-plugins'
          prompt: |
            Review ${{ github.repository }}/pull/${{ github.event.pull_request.number }}
            against the Brehon ADR rubric at
            `.github/ai-review-prompts/adr-rubric.md` and any matching per-phase
            rubric in the same directory. Flag ADR violations and cross-cutting
            invariant breaks before style or taste concerns.
          # See https://github.com/anthropics/claude-code-action/blob/main/docs/usage.md
          # or https://code.claude.com/docs/en/cli-reference for available options

