.claude/PRPs/reviews/pr-*-comment.md
.claude/PRPs/reviews/pr-*-cf-issue-body.md
.claude/PRPs/reviews/.cr-cache/

# Microsoft Word lock + temp files (created by Word when editing .docx in-place)
~$*
~WRL*.tmp

# Local environment — never commit secrets
.env
.env.local

# Rate-limit tracker state cache
.github/cache/

# MCP config — contains Ref API key and host-specific paths; lives only on
