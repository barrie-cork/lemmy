~WRL*.tmp

# Local environment — never commit secrets
.env
.env.local

# Rate-limit tracker state cache
.github/cache/

# MCP config — contains Ref API key and host-specific paths; lives only on
# the EliteDesk Junior daemon working directory, not in git.
.mcp.json

# Local project-memory MCP SQLite store (advisor-laptop session-only).
# Match both basename (file/symlink) and directory — bm-task #119 once
# committed self-referential symlinks to /srv/brehon-fork/.project-memory
# that slipped through the dir-only pattern; see chore(advisor) cleanup
# 2026-05-07. Same defence for .serena (Serena MCP not used on Rust repo).
.project-memory
.project-memory/
.serena
.serena/

# pi-coding per-machine/runtime state (stable .pi config is committed)
.pi/sessions/
.pi/tmp/
.pi/logs/
.pi/*.log
.pi/settings.local.json
.pi/extensions/*.js
.pi/extensions/*.js.map
.pi/extensions/*.d.ts

# DQ schema-v3 session-id cache (per-CC-session, gitignored per v1-dq-schema-r1)
.claude/.dq-session-id
.claude/memory/memory.db.pre-migration-*
# pre-commit-session-guard session intent file (per-CC-session, gitignored)
.claude/.staged-intent

# Comparator run forensics: keep gradeable artifacts (meta.json, *-plan.md, eval/*.json),
# exclude the multi-hundred-MB Pi event traces + session blobs from git.
