{
  "id": "brehon-harness-maintenance",
  "displayName": "Brehon Harness Maintenance",
  "type": "devops",
  "description": "Harness/RLS metadata profile: skill, lesson, retro, and pi harness files only; no app code.",
  "persona": "Brehon harness maintenance agent. Fix skill metadata, lesson/retro artifacts, pi harness scripts, and harness docs with narrow diffs; do not touch application code.",
  "tools": {
    "allowed": [
      "read",
      "write",
      "edit",
      "bash"
    ],
    "blocked": [],
    "readOnly": false
  },
  "guards": {
    "confirmDangerousCommands": true,
    "blockSecrets": true,
    "protectEnvFiles": true,
    "confirmGitPush": true,
    "confirmDeletes": true
  },
  "workflow": {
    "requirePlanBeforeEdit": false,
    "runTestsAfterEdit": false,
    "summarizeChanges": true
  },
  "ui": {
    "statusLabel": "BREHON:HARNESS",
    "themeHint": "yellow"
  },
  "policies": {
    "brehonMode": "harness-maintenance",
    "enforcement": "lemmy-hooks.ts"
  },
  "memory": [
    "This profile is UX only; .pi/extensions/lemmy-hooks.ts enforces the path policy.",
    "Allowed writes are .claude/skills/, .claude/lessons/, .claude/PRPs/reports/, .pi/skills/, .pi/scripts/, .pi/extensions/, and .pi/harness-factory/.",
    "Validate skill metadata with python3 .pi/scripts/validate-skills.py after skill edits; lesson writes trigger PMD sync hooks.",
    "Do not edit application code, Brehon plans, or Branch Manager artifacts in this mode."
  ],
  "packages": {
    "recommended": [
      "pi-harness-factory"
    ],
    "allowed": [
      "pi-harness-factory"
    ],
    "installCommands": [
      "pi install -l npm:pi-harness-factory@0.1.0"
    ]
  },
  "capabilities": {
    "brehonPathPolicy": {
      "enabled": true,
      "provider": "lemmy-hooks.ts"
    },
    "factoryUx": {
      "enabled": true,
      "provider": "pi-harness-factory"
    },
    "skillValidation": {
      "enabled": true,
      "provider": ".pi/scripts/validate-skills.py"
    },
    "recursiveLearning": {
      "enabled": true,
      "provider": ".pi/extensions/lemmy-hooks.ts + .pi/hook-scripts/lesson-pmd-sync.sh"
    }
  }
}
