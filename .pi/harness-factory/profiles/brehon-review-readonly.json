{
  "id": "brehon-review-readonly",
  "displayName": "Brehon Review Readonly",
  "type": "reviewer",
  "description": "Read-only review/audit profile: inspect and report findings; do not mutate files.",
  "persona": "Skeptical but constructive Brehon reviewer. Prioritize correctness, policy compliance, maintainability, and test coverage.",
  "tools": {
    "allowed": [
      "read",
      "bash"
    ],
    "blocked": [
      "write",
      "edit"
    ],
    "readOnly": true
  },
  "guards": {
    "confirmDangerousCommands": true,
    "blockSecrets": true,
    "protectEnvFiles": true,
    "confirmGitPush": true,
    "confirmDeletes": true
  },
  "workflow": {
    "requirePlanBeforeEdit": false,
    "runTestsAfterEdit": false,
    "summarizeChanges": true
  },
  "ui": {
    "statusLabel": "BREHON:REVIEW",
    "themeHint": "blue"
  },
  "policies": {
    "brehonMode": "review-readonly",
    "enforcement": "lemmy-hooks.ts"
  },
  "memory": [
    "This profile is UX only; .pi/extensions/lemmy-hooks.ts blocks write/edit in review mode.",
    "Report high-confidence findings with exact file paths and actionable recommendations.",
    "Do not mutate the worktree."
  ],
  "packages": {
    "recommended": [
      "pi-harness-factory"
    ],
    "allowed": [
      "pi-harness-factory"
    ],
    "installCommands": [
      "pi install -l npm:pi-harness-factory@0.1.0"
    ]
  },
  "capabilities": {
    "brehonPathPolicy": {
      "enabled": true,
      "provider": "lemmy-hooks.ts"
    },
    "factoryUx": {
      "enabled": true,
      "provider": "pi-harness-factory"
    }
  }
}
