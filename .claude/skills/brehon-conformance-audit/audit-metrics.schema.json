{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "scope",
    "head_sha",
    "run_at",
    "skill_version",
    "predictions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "scope": {
      "type": "string",
      "description": "phase-diff <branch> | file <path> | fn-list <comma-sep>"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "run_at": {
      "type": "string",
      "format": "date-time"
    },
    "skill_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "predictions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "axis",
          "risk_tier",
          "target",
          "sibling",
          "evidence"
        ],
        "properties": {
          "axis": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ]
          },
          "risk_tier": {
            "enum": [
              "1",
              "2",
              "3"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[^:]+:[0-9]+$",
            "description": "file:line"
          },
          "sibling": {
            "type": "string",
            "pattern": "^([^:]+:[0-9]+|NO_SIBLING_FOUND)$"
          },
          "evidence": {
            "type": "string",
            "maxLength": 120
          },
          "snapshot": {
            "type": "string",
            "description": "Optional run snapshot label (e.g. 'pre-fix-impl-3 (sha)')"
          }
        },
        "additionalProperties": false
      }
    },
    "ground_truth_compile_caught": {
      "type": "array",
      "description": "Populated post-\u00a715. Each entry: {axis, target, error_code, source_log}.",
      "items": {
        "type": "object",
        "required": [
          "axis",
          "target",
          "error_code",
          "source_log"
        ],
        "properties": {
          "axis": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[^:]+:[0-9]+$"
          },
          "error_code": {
            "type": "string"
          },
          "source_log": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "ground_truth_runtime": {
      "type": "array",
      "description": "Populated post-CR-triage (severity \u2265 major + sibling-conformance reference) AND post-merge bug fixes within 30 days. Each entry: {axis, target, source, evidence_commit_sha}.",
      "items": {
        "type": "object",
        "required": [
          "axis",
          "target",
          "source",
          "evidence_commit_sha"
        ],
        "properties": {
          "axis": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ]
          },
          "target": {
            "type": "string",
            "pattern": "^[^:]+:[0-9]+$"
          },
          "source": {
            "type": "string"
          },
          "evidence_commit_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,40}$"
          }
        },
        "additionalProperties": false
      }
    }
  }
}
