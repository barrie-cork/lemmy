{
  "effortLevel": "max",
  "skillListingBudgetFraction": 0.005,
  "env": {
    "_comment_pmd_cross_lane": "PROJECT_MEMORY_DB and OLLAMA_URL are cross-lane PMD constants exposed in every CC session env (per .claude/rules/pmd-invariants.md invariant #1 + feedback_pmd_cross_lane_canonical_db.md). PROJECT_MEMORY_DB must be the ABSOLUTE path to the canonical brehon-fork checkout's .project-memory/memory.db — NEVER relative, NEVER per-worktree. OLLAMA_URL is the Tailscale-routed endpoint for the homeserver Ollama embedder used by the project-memory MCP and dist/scripts/backfill.js. PROJECT_ROOT is deliberately NOT set here — each lane worktree's .mcp.json carries its own PROJECT_ROOT.",
    "PROJECT_MEMORY_DB": "C:/Users/barri/Developer/brehon-fork/.project-memory/memory.db",
    "OLLAMA_URL": "http://homeserver:11434"
  },
  "permissions": {
    "allow": [
      "Edit(.claude/runlog/**)",
      "Write(.claude/runlog/**)",
      "Bash(cat >> .claude/runlog/**)",
      "Edit(.claude/PRPs/reviews/**)",
      "Write(.claude/PRPs/reviews/**)",
      "Edit(.claude/decision-queue.json)",
      "Write(.claude/decision-queue.json)",
      "Edit(.claude/skills/**)",
      "Write(.claude/skills/**)",
      "Edit(.claude/lessons/**)",
      "Write(.claude/lessons/**)",
      "Edit(.claude/rules/**)",
      "Write(.claude/rules/**)",
      "Edit(.claude/PRPs/audit-metrics/**)",
      "Write(.claude/PRPs/audit-metrics/**)",
      "Edit(.claude/PRPs/reports/**)",
      "Write(.claude/PRPs/reports/**)",
      "Edit(.claude/PRPs/briefs/**)",
      "Write(.claude/PRPs/briefs/**)",
      "Edit(.claude/PRPs/plans/**)",
      "Write(.claude/PRPs/plans/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/retro-check.sh",
            "timeout": 10000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/check-cargo-pipe.sh"
          },
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/refuse-ssh-reset-hard-shared-checkout.sh"
          }
        ]
      },
      {
        "matcher": "mcp__project-memory__memory_search|mcp__vault-memory__memory_search",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/validate-memory-search.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": "Bash|Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/worktree-guard.sh",
            "timeout": 5000
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-dq-state.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-phase-audit.sh"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/pre-phase-audit.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/edit-readback-reminder.sh",
            "timeout": 5000
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/observation-capture.sh",
            "timeout": 5000
          }
        ]
      }
    ]
  }
}
